{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["dom", "dom.iterable", "es2022"],
		"types": ["vite/client"],
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"paths": {
			"common/*": ["./src/common/*"],
			"components/*": ["./src/components/*"],
			"imgs/*": ["./src/imgs/*"],
			"store": ["./src/store"],
			"store/*": ["./src/store/*"],
			"styles/*": ["./src/styles/*"]
		}
	},
	"include": ["src"]
}
